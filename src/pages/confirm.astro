---
import AppLayout from "../layouts/AppLayout.astro";
import { confirmSentence } from "../lib/destination";
import {
  clearDraft,
  clearPendingDestinationId,
  getDraft,
  getPendingDestinationId,
  requireMerchant,
  setOnceSecrets,
} from "../lib/session";
import { confirmDestination, provisionKeys, saveDraft, syncFromService } from "../lib/store";

export const prerender = false;

const gate = requireMerchant(Astro.cookies, Astro.request);
if (gate instanceof Response) return gate;
const tenantId = gate.businessId;

let draft = getDraft(Astro.cookies);
const merchant = await syncFromService(tenantId);
let error: string | null = null;

if (!draft && merchant.destination) {
  draft = merchant.destination;
}

if (!draft) {
  return Astro.redirect("/destination");
}

if (Astro.request.method === "POST") {
  try {
    const pendingId = getPendingDestinationId(Astro.cookies);
    if (!pendingId) await saveDraft(tenantId, draft);
    await confirmDestination(tenantId, pendingId ?? undefined);
    const secrets = await provisionKeys(tenantId);
    setOnceSecrets(Astro.cookies, secrets);
    clearDraft(Astro.cookies);
    clearPendingDestinationId(Astro.cookies);
    return Astro.redirect("/keys");
  } catch (e) {
    error = e instanceof Error ? e.message : "Could not confirm.";
  }
}

const name = draft.displayName ?? "Your business";
const sentence = confirmSentence(draft);
---

<AppLayout title="Confirm" section="Setup" step={2}>
  <header class="page-head">
    <div>
      <span class="page-kicker">Step 2 of 4</span>
      <h1>Does this look right?</h1>
      <p class="lede">
        Double-check. This is where money will be sent when a customer pays. A wrong number sends it
        to someone else.
      </p>
    </div>
  </header>

  {error && <p class="callout callout-error" role="alert">{error}</p>}

  <div class="split">
    <section class="card">
      <div class="card-head">
        <span class="section-kicker">Verified name</span>
        <span class="pill pill-ok">Ready to confirm</span>
      </div>
      <div class="card-body">
        <p class="t-2xl mb-4">{name}</p>
        <p class="lede">{sentence}</p>
      </div>
      <div class="card-foot">
        <form method="post" action="/confirm" class="actions">
          <button type="submit" class="btn btn-accent">Confirm</button>
          <a class="btn btn-ghost" href="/destination">Edit</a>
        </form>
      </div>
    </section>

    <aside class="aside">
      <div class="soft-yellow">
        <p class="section-kicker section-kicker--ink">Before you confirm</p>
        <p class="note ink">
          Read the number back against what your customer will type on their phone. Confirming also
          issues your API keys, which are shown once.
        </p>
      </div>
    </aside>
  </div>
</AppLayout>
