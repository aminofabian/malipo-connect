---
import AppLayout from "../layouts/AppLayout.astro";
import { requireMerchant } from "../lib/session";
import { publicApiBase, setWebhookUrl, syncFromService } from "../lib/store";

export const prerender = false;

const gate = requireMerchant(Astro.cookies, Astro.request);
if (gate instanceof Response) return gate;
const tenantId = gate.businessId;

let merchant = await syncFromService(tenantId);
let siteUrl = merchant.webhookUrl ?? "";
let error: string | null = null;
let notice: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  siteUrl = String(form.get("site_url") ?? "").trim();

  try {
    const saved = await setWebhookUrl(tenantId, siteUrl);
    notice = saved ? "Website URL saved." : "Website URL cleared.";
    merchant = await syncFromService(tenantId);
    siteUrl = merchant.webhookUrl ?? "";
  } catch (e) {
    error = e instanceof Error ? e.message : "Could not save the URL.";
  }
}

const base = publicApiBase();
const hasKey = Boolean(merchant.clientId);

const quickstart = hasKey
  ? `const res = await fetch("${base}/v1/payments", {
  method: "POST",
  headers: {
    Authorization: "Bearer sk_live_…",
    "Content-Type": "application/json",
  },
  body: JSON.stringify({
    amount: "100.00",
    customer_phone: "254712345678",
    reference: "order-1042",
    idempotency_key: "order-1042-1",
  }),
});

const payment = await res.json();
// { id, status: "pending", amount, currency, reference }`
  : "";
---

<AppLayout title="Settings" section="Account" current="settings" email={gate.email}>
  <header class="page-head">
    <div>
      <span class="page-kicker">Account</span>
      <h1>Integration settings</h1>
      <p class="lede">
        Everything your website or app needs to take M‑Pesa payments, and where we send the result.
      </p>
    </div>
    <div class="page-actions">
      <a class="btn btn-ghost" href="/keys">API keys</a>
      <a class="btn btn-ghost" href="/destinations">Destinations</a>
    </div>
  </header>

  <div class="blocks">
    {error && <p class="callout callout-error" role="alert">{error}</p>}
    {notice && <p class="callout callout-ok" role="status">{notice}</p>}

    <div class="grid-2">
      <section class="card">
        <div class="card-head">
          <h2>Website URL</h2>
        </div>
        <div class="card-body">
          <p class="note mb-4">
            The <code>https</code> address of the site you are integrating. When a customer pays or
            cancels, we POST the result here. A payment that carries its own{" "}
            <code>callback_url</code> uses that instead.
          </p>

          {
            hasKey ? (
              <form method="post" action="/settings" class="stack">
                <div class="field">
                  <label for="site_url">Your website / callback URL</label>
                  <input
                    id="site_url"
                    name="site_url"
                    type="url"
                    inputmode="url"
                    autocomplete="url"
                    placeholder="https://shop.example/malipo/webhook"
                    value={siteUrl}
                  />
                  <span class="field-hint">
                    Must be <code>https</code> (or <code>http://localhost</code> while testing). Leave
                    it blank to stop sending callbacks.
                  </span>
                </div>
                <div class="actions">
                  <button type="submit" class="btn btn-primary">Save URL</button>
                  <a class="btn btn-ghost" href="/guide#callback">How callbacks work</a>
                </div>
              </form>
            ) : (
              <div class="empty">
                <p>Publish your API keys first — the website URL is stored with them.</p>
                <a class="btn btn-primary btn-sm" href="/keys">Go to Keys</a>
              </div>
            )
          }

          <p class="note mt-4">
            We sign every callback with your webhook signing secret (<code>X-Malipo-Signature</code>).{" "}
            <a href="/guide#verify">How to verify a callback</a>.
          </p>
        </div>
      </section>

      <section class="card">
        <div class="card-head">
          <h2>Your account</h2>
        </div>
        <div class="card-body">
          <p class="note mb-4">
            Your secret keys are shown once when issued. If you have lost them, rotate on the{" "}
            <a href="/keys">Keys</a> page — the old ones stop immediately.
          </p>

          <div class="copy-list">
            <div class="copy-row">
              <span class="copy-row-label">Client ID</span>
              <span class="copy-row-value">
                <code>{merchant.clientId ?? "— not issued yet —"}</code>
                {
                  merchant.clientId && (
                    <button type="button" class="btn btn-ghost btn-sm" data-copy-btn={merchant.clientId}>
                      Copy
                    </button>
                  )
                }
              </span>
            </div>
            <div class="copy-row">
              <span class="copy-row-label">Client secret</span>
              <span class="copy-row-value">
                <span class={`pill ${merchant.clientId ? "pill-on" : "pill-draft"}`}>
                  {merchant.clientId ? "Issued (shown once)" : "Not issued"}
                </span>
              </span>
            </div>
            <div class="copy-row">
              <span class="copy-row-label">Webhook secret</span>
              <span class="copy-row-value">
                <span class={`pill ${merchant.clientId ? "pill-on" : "pill-draft"}`}>
                  {merchant.clientId ? "Issued (shown once)" : "Not issued"}
                </span>
              </span>
            </div>
          </div>
        </div>
      </section>
    </div>

    <div class="grid-2">
      <section class="card">
        <div class="card-head">
          <h2>API details</h2>
        </div>
        <div class="card-body">
          <div class="copy-list mb-4">
            <div class="copy-row">
              <span class="copy-row-label">Endpoint base URL</span>
              <span class="copy-row-value">
                <code>{base}</code>
                <button type="button" class="btn btn-ghost btn-sm" data-copy-btn={base}>Copy</button>
              </span>
            </div>
          </div>

          <ul class="endpoint-list">
            <li>
              <span class="method method-post">POST</span>
              <code>/v1/payments</code>
              <span class="endpoint-what">Start an M‑Pesa prompt. Returns the payment.</span>
            </li>
            <li>
              <span class="method method-get">GET</span>
              <code>/v1/payments/{"{id}"}</code>
              <span class="endpoint-what">Check one payment until it settles or fails.</span>
            </li>
          </ul>
        </div>
      </section>

      <section class="card">
        <div class="card-head">
          <h2>Authentication</h2>
        </div>
        <div class="card-body">
          <p class="note mb-4">
            Send your client secret on every request, one of these two ways:
          </p>
          <div class="copy-list">
            <div class="copy-row">
              <span class="copy-row-label">Bearer token</span>
              <span class="copy-row-value">
                <code>Authorization: Bearer sk_live_…</code>
                <button
                  type="button"
                  class="btn btn-ghost btn-sm"
                  data-copy-btn="Authorization: Bearer sk_live_…"
                >
                  Copy
                </button>
              </span>
            </div>
            <div class="copy-row">
              <span class="copy-row-label">HTTP Basic</span>
              <span class="copy-row-value">
                <code>Authorization: Basic base64(client_id:client_secret)</code>
              </span>
            </div>
          </div>
          <p class="note mt-4">
            Keep the secret on your server. Never ship it to the browser.
          </p>
        </div>
      </section>
    </div>

    {
      hasKey && (
        <section class="card">
          <div class="card-head">
            <h2>Quick start</h2>
            <button type="button" class="btn btn-accent btn-sm" data-copy-btn={quickstart}>
              Copy the request
            </button>
          </div>
          <div class="card-body">
            <p class="note mb-3">
              Paste your client secret where it says <code>sk_live_…</code>.
            </p>
            <pre class="snippet">{quickstart}</pre>
            <p class="note mt-4">
              Then poll <code>GET {base}/v1/payments/{"{id}"}</code>, or let us POST to your
              website URL above. <a href="/guide">Read the full guide</a>.
            </p>
          </div>
        </section>
      )
    }
  </div>
</AppLayout>

<script>
  document.querySelectorAll("[data-copy-btn]").forEach((btn) => {
    const label = btn.textContent ?? "Copy";
    btn.addEventListener("click", async () => {
      const text = btn.getAttribute("data-copy-btn") ?? "";
      try {
        await navigator.clipboard.writeText(text);
        btn.classList.add("is-copied");
        btn.textContent = "Copied";
        setTimeout(() => {
          btn.classList.remove("is-copied");
          btn.textContent = label;
        }, 1200);
      } catch {
        const span = btn.previousElementSibling;
        if (span) {
          const range = document.createRange();
          range.selectNodeContents(span);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
      }
    });
  });
</script>
