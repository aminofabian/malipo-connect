---
import AppLayout from "../layouts/AppLayout.astro";
import Icon from "../components/Icon.astro";
import { savedDestinationLabel, savedDestinationStatus } from "../lib/destination";
import type { SavedDestinationSummary } from "../lib/destination";
import { listDestinations, malipoConfigured } from "../lib/malipo";
import { requireMerchant } from "../lib/session";
import { getSummary, syncFromService } from "../lib/store";

export const prerender = false;

const gate = requireMerchant(Astro.cookies, Astro.request);
if (gate instanceof Response) return gate;
const merchant = gate;

const row = await syncFromService(merchant.businessId);
const hasKey = Boolean(row.clientId);

let dests: SavedDestinationSummary[] = [];
if (malipoConfigured()) {
  try {
    const res = await listDestinations(merchant.businessId);
    dests = (res.destinations ?? []) as SavedDestinationSummary[];
  } catch {
    dests = [];
  }
}

const active = dests.find((d) => d.active) ?? null;
const anyVerified = dests.some((d) => d.verified);
const ready = hasKey && Boolean(active);

const summary = await getSummary(merchant.businessId);
const receivedCount = summary?.received_count ?? 0;
const receivedTotal = summary?.received_total ?? "0";
const tested = receivedCount > 0;

function kes(amount: string): string {
  const n = Number(amount);
  if (!Number.isFinite(n)) return `KES ${amount}`;
  return `KES ${n.toLocaleString("en-KE", {
    minimumFractionDigits: n % 1 === 0 ? 0 : 2,
    maximumFractionDigits: 2,
  })}`;
}

const steps = [
  { label: "Add where money lands", done: dests.length > 0, href: "/destinations", optional: false },
  { label: "Confirm a destination", done: anyVerified, href: "/destinations", optional: false },
  { label: "Publish your API keys", done: hasKey, href: "/keys", optional: false },
  { label: "Send a test payment", done: tested, href: "/test", optional: true },
];

const doneCount = steps.filter((s) => s.done).length;
---

<AppLayout
  title="Overview"
  section="Payments"
  current="home"
  email={merchant.email}
>
  <header class="page-head">
    <div>
      <span class="page-kicker">Receive M‑Pesa payments</span>
      <h1>Your setup at a glance</h1>
      <p class="lede">
        Money lands in the till, paybill, or bank account you confirm. Customers get an M‑Pesa push
        on their phone; once they enter their PIN, it arrives with you.
      </p>
    </div>
    <div class="page-actions">
      {
        ready ? (
          <a class="btn btn-primary" href="/keys">
            View your request
          </a>
        ) : (
          <a class="btn btn-primary" href="/destination">
            Get started
          </a>
        )
      }
      <a class="btn btn-ghost" href="/destinations">
        Destinations{dests.length > 0 ? ` (${dests.length})` : ""}
      </a>
    </div>
  </header>

  <div class="blocks">
    {
      ready ? (
        <p class="callout callout-ok" role="status">
          <span class="callout-title">Ready — payments land in {savedDestinationLabel(active!)}.</span>
          <span>{active && savedDestinationStatus(active).label}. Keep going by sending a test payment.</span>
        </p>
      ) : (
        <p class="callout callout-warn" role="status">
          <span class="callout-title">Not taking payments yet.</span>
          <span>Finish the steps below to go live.</span>
        </p>
      )
    }

    {
      receivedCount > 0 && (
        <section class="summary-bar" aria-label="Received so far">
          <span class="figure">
            <span class="figure-value">{kes(receivedTotal)}</span>
            <span class="figure-label">
              received across {receivedCount} settled payment{receivedCount === 1 ? "" : "s"}
            </span>
          </span>
          <a class="btn btn-ghost btn-sm" href="/keys?scope=all">
            View all payments
          </a>
        </section>
      )
    }

    <div class="split">
      <div class="blocks">
        <section class="card" aria-labelledby="setup-heading">
          <div class="card-head">
            <h2 id="setup-heading">Setup — {doneCount} of {steps.length} done</h2>
            <a class="btn btn-ghost btn-sm" href="/settings">Settings</a>
          </div>

          <div class="card-body">
            {
              doneCount > 0 && (
                <div class="progress" aria-hidden="true">
                  <div
                    class="progress-bar"
                    style={`width: ${(doneCount / steps.length) * 100}%`}
                  />
                </div>
              )
            }
            <p class="sr-only">
              {doneCount} of {steps.length} setup steps complete.
            </p>

            <ul class="checklist mt-4">
              {steps.map((step) => (
                <li class:list={["checklist-item", { "checklist-done": step.done }]}>
                  <span class="checklist-mark" aria-hidden="true">
                    <Icon name={step.done ? "check" : "circle"} size="sm" />
                  </span>
                  <a class="checklist-label" href={step.href}>
                    {step.label}
                  </a>
                  {step.optional && !step.done && <span class="checklist-tag">optional</span>}
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section aria-labelledby="how-heading">
          <div class="section-head">
            <div>
              <h2 class="section-title" id="how-heading">How it works</h2>
              <p class="section-hint">
                The same three steps on every integration, whichever destination you choose.
              </p>
            </div>
          </div>

          <ol class="flow">
            <li>
              <b>01</b>
              <span>Add where money lands</span>
            </li>
            <li>
              <b>02</b>
              <span>Copy one request</span>
            </li>
            <li>
              <b>03</b>
              <span>Get paid</span>
            </li>
          </ol>
        </section>
      </div>

      <aside class="aside">
        <section class="card" aria-labelledby="dest-heading">
          <div class="card-head">
            <h2 id="dest-heading">Destination</h2>
          </div>
          <div class="card-body">
            {
              active ? (
                <>
                  <span class="dest-hero-kicker">Receiving payments</span>
                  <p class="dest-row-label mt-2 mb-2">
                    {savedDestinationLabel(active)}
                  </p>
                  <p class="dest-row-meta">
                    {savedDestinationStatus(active).hint}
                  </p>
                </>
              ) : (
                <div class="empty empty--bare">
                  <p>
                    No destination is receiving payments yet. Add a till, paybill, or bank account to
                    get started.
                  </p>
                  <a class="btn btn-accent" href="/destination">
                    Add a destination
                  </a>
                </div>
              )
            }
          </div>
          <div class="card-foot">
            <a class="btn btn-ghost btn-sm" href="/destinations">Manage all</a>
            <a class="btn btn-ghost btn-sm" href="/guide">Read the guide</a>
          </div>
        </section>

        <details class="explainer">
          <summary>Which key is which?</summary>
          <div class="explainer-body">
            <p>
              <strong>Client secret</strong> (<code>sk_live_…</code>) authenticates your server on
              every request. <strong>Webhook signing secret</strong> (<code>whsec_…</code>) proves
              a callback came from Malipo. Both are shown once.
            </p>
            <p>
              The <strong>client ID</strong> (<code>pk_live_…</code>) is not a secret — it is safe to
              keep in your configuration.
            </p>
          </div>
        </details>
      </aside>
    </div>
  </div>
</AppLayout>
