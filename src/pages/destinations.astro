---
import AppLayout from "../layouts/AppLayout.astro";
import {
  destinationKindLabel,
  savedDestinationFacts,
  savedDestinationLabel,
  savedDestinationStatus,
} from "../lib/destination";
import type { SavedDestinationSummary } from "../lib/destination";
import { listDestinations, malipoConfigured } from "../lib/malipo";
import { requireMerchant } from "../lib/session";
import {
  activateSavedDestination,
  confirmDestination,
  getSummary,
  syncFromService,
} from "../lib/store";

export const prerender = false;

const gate = requireMerchant(Astro.cookies, Astro.request);
if (gate instanceof Response) return gate;
const tenantId = gate.businessId;

let error: string | null = null;
let notice: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("_action") ?? "");
  const id = String(form.get("id") ?? "");

  try {
    if (id && action === "activate") {
      await activateSavedDestination(tenantId, id);
      await syncFromService(tenantId);
      notice = "That destination now receives payments.";
    } else if (id && action === "confirm") {
      await confirmDestination(tenantId, id);
      await syncFromService(tenantId);
      notice = "Destination confirmed and set to receive payments.";
    } else {
      error = "That action was missing a destination.";
    }
  } catch (e) {
    error = e instanceof Error ? e.message : "Could not update the destination.";
  }
}

let saved: SavedDestinationSummary[] = [];

if (malipoConfigured()) {
  try {
    const res = await listDestinations(tenantId);
    saved = (res.destinations ?? []) as SavedDestinationSummary[];
  } catch {
    saved = [];
  }
}

const active = saved.find((d) => d.active) ?? null;
const ready = saved.filter((d) => !d.active && d.verified);
const drafts = saved.filter((d) => !d.verified);

const summary = await getSummary(tenantId);
const totalsById = new Map<string, { count: number; total: string }>();

if (summary) {
  for (const row of summary.by_destination) {
    if (row.destination_id) totalsById.set(row.destination_id, { count: row.count, total: row.total });
  }
}

const receivedCount = summary?.received_count ?? 0;
const receivedTotal = summary?.received_total ?? "0";

function kes(amount: string): string {
  const n = Number(amount);
  if (!Number.isFinite(n)) return `KES ${amount}`;
  return `KES ${n.toLocaleString("en-KE", {
    minimumFractionDigits: n % 1 === 0 ? 0 : 2,
    maximumFractionDigits: 2,
  })}`;
}

function receivedLine(d: SavedDestinationSummary): string | null {
  const total = totalsById.get(d.id);
  if (!total) return null;
  return `Received ${kes(total.total)} · ${total.count} payment${total.count === 1 ? "" : "s"}`;
}

function addedOn(iso?: string | null): string {
  if (!iso) return "—";
  try {
    return new Date(iso).toLocaleDateString("en-KE", {
      day: "numeric",
      month: "short",
      year: "numeric",
    });
  } catch {
    return "—";
  }
}

function meta(d: SavedDestinationSummary): string {
  return `${destinationKindLabel(d.kind)} · added ${addedOn(d.inserted_at)}`;
}
---

<AppLayout
  title="Destinations"
  section="Payments"
  current="destinations"
  email={gate.email}
>
  <header class="page-head">
    <div>
      <span class="page-kicker">Where money lands</span>
      <h1>Your destinations</h1>
      <p class="lede">
        Save as many as you like — a till, a paybill, a bank account. Only the one marked{" "}
        <strong>In use</strong> receives payments, and switching is instant.
      </p>
    </div>
    <div class="page-actions">
      <a class="btn btn-primary" href="/destination">Add a destination</a>
      <a class="btn btn-ghost" href="/keys">API keys</a>
    </div>
  </header>

  <div class="blocks">
    {error && <p class="callout callout-error" role="alert">{error}</p>}
    {notice && <p class="callout callout-ok" role="status">{notice}</p>}

    {
      saved.length > 0 && receivedCount > 0 && (
        <section class="summary-bar" aria-label="Received so far">
          <span class="figure">
            <span class="figure-value">{kes(receivedTotal)}</span>
            <span class="figure-label">
              received across {receivedCount} settled payment{receivedCount === 1 ? "" : "s"}
            </span>
          </span>
          <a class="btn btn-ghost btn-sm" href="/keys?scope=all">
            View all payments
          </a>
        </section>
      )
    }

    {
      saved.length === 0 ? (
        <div class="empty">
          <span class="section-kicker">Nothing saved yet</span>
          <p>
            You have not saved a destination yet. Add the till, paybill, or bank account that should
            receive money when a customer pays.
          </p>
          <a class="btn btn-primary" href="/destination">
            Add a destination
          </a>
        </div>
      ) : (
        <>
          {!active && ready.length > 0 && (
            <p class="callout callout-warn" role="status">
              <span class="callout-title">None of your destinations is receiving payments yet.</span>
              <span style="font-weight: 400">Pick one below and set it as default.</span>
            </p>
          )}

          {active && (
            <section class="dest-hero" aria-label="Receiving payments">
              <div
                style="display:flex; align-items:center; justify-content:space-between; gap:var(--s4); flex-wrap:wrap"
              >
                <div>
                  <span class="dest-hero-kicker">Receiving payments</span>
                  <p class="dest-hero-label">{savedDestinationLabel(active)}</p>
                  <p class="dest-hero-meta">{meta(active)}</p>
                  {receivedLine(active) && (
                    <p class="dest-hero-meta" style="font-weight: 600; color: var(--teal-deep)">
                      {receivedLine(active)}
                    </p>
                  )}
                </div>
                <div class="actions">
                  <a class="btn btn-primary btn-sm" href={`/destinations/${active.id}`}>
                    View details
                  </a>
                  <a class="btn btn-ghost btn-sm" href="/keys">
                    Go to API keys
                  </a>
                </div>
              </div>

              <dl class="fact-list" style="margin-top: var(--s5)">
                {savedDestinationFacts(active).map((fact) => (
                  <div>
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}

          {ready.length > 0 && (
            <section aria-labelledby="ready-heading">
              <div class="section-head">
                <div>
                  <span class="section-kicker">Confirmed</span>
                  <h2 class="section-title" id="ready-heading">Ready to use</h2>
                  <p class="section-hint">
                    Confirmed, but not the default. Switching is instant and does not change your
                    API keys.
                  </p>
                </div>
              </div>
              <ul class="dest-list">
                {ready.map((d) => {
                  const status = savedDestinationStatus(d);
                  return (
                    <li class="dest-row">
                      <div class="dest-row-main">
                        <div class="dest-row-top">
                          <span class="dest-row-label">{savedDestinationLabel(d)}</span>
                          <span class={`pill pill-${status.tone}`}>{status.label}</span>
                        </div>
                        <dl class="fact-list">
                          {savedDestinationFacts(d).map((fact) => (
                            <div>
                              <dt>{fact.label}</dt>
                              <dd>{fact.value}</dd>
                            </div>
                          ))}
                        </dl>
                        <p class="dest-row-meta">{status.hint}</p>
                        {receivedLine(d) && (
                          <p class="dest-row-meta" style="font-weight: 600; color: var(--teal-deep)">
                            {receivedLine(d)}
                          </p>
                        )}
                      </div>
                      <div class="dest-row-actions">
                        <form method="post" action="/destinations">
                          <input type="hidden" name="_action" value="activate" />
                          <input type="hidden" name="id" value={d.id} />
                          <button type="submit" class="btn btn-primary btn-sm">
                            Set as default
                          </button>
                        </form>
                        <a class="btn btn-ghost btn-sm" href={`/destinations/${d.id}`}>
                          Details
                        </a>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </section>
          )}

          {drafts.length > 0 && (
            <section aria-labelledby="draft-heading">
              <div class="section-head">
                <div>
                  <span class="section-kicker">Action needed</span>
                  <h2 class="section-title" id="draft-heading">Needs confirmation</h2>
                  <p class="section-hint">
                    Confirm these before they can receive money. The numbers are checked once, then
                    the destination is trusted.
                  </p>
                </div>
              </div>
              <ul class="dest-list">
                {drafts.map((d) => {
                  const status = savedDestinationStatus(d);
                  return (
                    <li class="dest-row">
                      <div class="dest-row-main">
                        <div class="dest-row-top">
                          <span class="dest-row-label">{savedDestinationLabel(d)}</span>
                          <span class={`pill pill-${status.tone}`}>{status.label}</span>
                        </div>
                        <dl class="fact-list">
                          {savedDestinationFacts(d).map((fact) => (
                            <div>
                              <dt>{fact.label}</dt>
                              <dd>{fact.value}</dd>
                            </div>
                          ))}
                        </dl>
                        <p class="dest-row-meta">{status.hint}</p>
                        {receivedLine(d) && (
                          <p class="dest-row-meta" style="font-weight: 600; color: var(--teal-deep)">
                            {receivedLine(d)}
                          </p>
                        )}
                      </div>
                      <div class="dest-row-actions">
                        <form method="post" action="/destinations">
                          <input type="hidden" name="_action" value="confirm" />
                          <input type="hidden" name="id" value={d.id} />
                          <button type="submit" class="btn btn-teal btn-sm">
                            Confirm &amp; use
                          </button>
                        </form>
                        <a class="btn btn-ghost btn-sm" href={`/destinations/${d.id}`}>
                          Details
                        </a>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </section>
          )}

          <details class="explainer">
            <summary>How destinations work</summary>
            <div class="explainer-body">
              <p>
                You can keep several destinations saved — for example a shop till and a bank account.
                Only the one marked <strong>In use</strong> receives customer payments. Changing the
                default is instant; your API keys and live payments are untouched.
              </p>
              <p>
                A destination must be <strong>confirmed</strong> before it can receive money.
                Confirming also makes it the default.
              </p>
            </div>
          </details>
        </>
      )
    }
  </div>
</AppLayout>
