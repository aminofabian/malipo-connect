---
import AuthLayout from "../layouts/AuthLayout.astro";
import { loginAccount, malipoConfigured } from "../lib/malipo";
import { decodeConnectSession, setConnectSession } from "../lib/session";

export const prerender = false;

const url = new URL(Astro.request.url);
const nextRaw = url.searchParams.get("next") || "/destination";
const next = nextRaw.startsWith("/") && !nextRaw.startsWith("//") ? nextRaw : "/destination";

const existing = decodeConnectSession(Astro.cookies.get("mc_session")?.value);
if (existing && Astro.request.method === "GET") {
  return Astro.redirect(next);
}

let error: string | null = null;
let emailValue = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  emailValue = String(form.get("email") ?? "").trim();
  const password = String(form.get("password") ?? "");

  if (!malipoConfigured()) {
    error = "Malipo service is not configured (set MALIPO_SERVICE_URL).";
  } else if (!emailValue || !password) {
    error = "Enter your email and password.";
  } else {
    try {
      const account = await loginAccount({ email: emailValue, password });
      setConnectSession(Astro.cookies, {
        businessId: account.business_id,
        email: account.email,
        sub: account.id,
        exp: Math.floor(Date.now() / 1000) + 60 * 60 * 24 * 14,
      });
      return Astro.redirect(next);
    } catch (e) {
      const status = (e as { status?: number }).status;
      error =
        status === 401
          ? "Email or password is incorrect."
          : e instanceof Error
            ? e.message
            : "Could not sign in.";
    }
  }
}
---

<AuthLayout
  title="Sign in · Malipo Connect"
  heading="Start taking M-Pesa payments"
  lede="One account holds your destination, your API keys, and every payment you take."
  points={[
    { title: "Add a destination", body: "A till, paybill, or bank account that receives the money." },
    { title: "Copy one request", body: "Your key and a ready-made request, ready to paste." },
    { title: "Get paid", body: "Customers approve an M-Pesa prompt on their own phone." },
  ]}
>
  <h1 style="font-size: var(--fs-2xl)">Sign in</h1>
  <p class="lede" style="color: var(--ink-muted); margin-top: var(--s2); margin-bottom: var(--s6)">
    Use your Malipo Connect account — email and password.
  </p>

  {
    error && (
      <p class="callout callout-error" role="alert">
        {error}
      </p>
    )
  }

  <form method="post" action={`/signin?next=${encodeURIComponent(next)}`} class="stack">
    <div class="field">
      <label for="email">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="username"
        required
        autofocus
        value={emailValue}
      />
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="current-password"
        required
        minlength="8"
      />
    </div>
    <div class="actions">
      <button type="submit" class="btn btn-primary btn-block">Sign in</button>
    </div>
  </form>

  <p class="note" style="margin-top: var(--s6)">
    New here? <a href={`/signup?next=${encodeURIComponent(next)}`}>Create an account</a>
  </p>
</AuthLayout>
