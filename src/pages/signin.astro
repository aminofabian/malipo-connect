---
import WizardLayout from "../layouts/WizardLayout.astro";
import { loginAccount, malipoConfigured } from "../lib/malipo";
import { decodeConnectSession, setConnectSession } from "../lib/session";

export const prerender = false;

const url = new URL(Astro.request.url);
const nextRaw = url.searchParams.get("next") || "/destination";
const next = nextRaw.startsWith("/") && !nextRaw.startsWith("//") ? nextRaw : "/destination";

const existing = decodeConnectSession(Astro.cookies.get("mc_session")?.value);
if (existing && Astro.request.method === "GET") {
  return Astro.redirect(next);
}

let error: string | null = null;
let emailValue = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  emailValue = String(form.get("email") ?? "").trim();
  const password = String(form.get("password") ?? "");

  if (!malipoConfigured()) {
    error = "Malipo service is not configured (set MALIPO_SERVICE_URL).";
  } else if (!emailValue || !password) {
    error = "Enter your email and password.";
  } else {
    try {
      const account = await loginAccount({ email: emailValue, password });
      setConnectSession(Astro.cookies, {
        businessId: account.business_id,
        email: account.email,
        sub: account.id,
        exp: Math.floor(Date.now() / 1000) + 60 * 60 * 24 * 14,
      });
      return Astro.redirect(next);
    } catch (e) {
      const status = (e as { status?: number }).status;
      error =
        status === 401
          ? "Email or password is incorrect."
          : e instanceof Error
            ? e.message
            : "Could not sign in.";
    }
  }
}
---

<WizardLayout title="Sign in · Malipo Connect">
  <h1>Sign in</h1>
  <p class="lede">Use your Malipo Connect account — email and password.</p>

  {
    error && (
      <p class="err" role="alert">
        {error}
      </p>
    )
  }

  <form method="post" action={`/signin?next=${encodeURIComponent(next)}`} class="stack">
    <div class="field">
      <label for="email">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="username"
        required
        value={emailValue}
      />
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="current-password"
        required
        minlength="8"
      />
    </div>
    <div class="actions">
      <button type="submit" class="btn btn-primary">Sign in</button>
    </div>
  </form>

  <p class="note" style="margin-top: 1.5rem">
    New here? <a href={`/signup?next=${encodeURIComponent(next)}`}>Create an account</a>
  </p>
</WizardLayout>
