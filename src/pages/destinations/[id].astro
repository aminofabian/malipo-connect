---
import AppLayout from "../../layouts/AppLayout.astro";
import Icon from "../../components/Icon.astro";
import {
  savedDestinationFacts,
  savedDestinationLabel,
  savedDestinationSentence,
  savedDestinationStatus,
} from "../../lib/destination";
import { getDestination, malipoConfigured } from "../../lib/malipo";
import type { SavedDestination } from "../../lib/malipo";
import { requireMerchant } from "../../lib/session";
import { activateSavedDestination, confirmDestination, syncFromService } from "../../lib/store";

export const prerender = false;

const gate = requireMerchant(Astro.cookies, Astro.request);
if (gate instanceof Response) return gate;
const tenantId = gate.businessId;

const { id } = Astro.params;
if (!id) return Astro.redirect("/destinations");

if (!malipoConfigured()) return Astro.redirect("/destinations");

let error: string | null = null;
let notice: string | null = null;
let dest: SavedDestination;

try {
  dest = await getDestination(tenantId, id);
} catch {
  return Astro.redirect("/destinations");
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("_action") ?? "");

  try {
    if (action === "activate") {
      await activateSavedDestination(tenantId, id);
      await syncFromService(tenantId);
      notice = "This destination now receives payments.";
    } else if (action === "confirm") {
      await confirmDestination(tenantId, id);
      await syncFromService(tenantId);
      notice = "Destination confirmed and set to receive payments.";
    }
    dest = await getDestination(tenantId, id);
  } catch (e) {
    error = e instanceof Error ? e.message : "Could not update destination.";
  }
}

const label = savedDestinationLabel(dest);
const status = savedDestinationStatus(dest);
const facts = savedDestinationFacts(dest);
const sentence = savedDestinationSentence(dest);

function addedDate(iso?: string | null): string {
  if (!iso) return "—";
  try {
    return new Date(iso).toLocaleString("en-KE", {
      day: "numeric",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  } catch {
    return "—";
  }
}
---

<AppLayout title={label} section="Destinations" current="destinations" email={gate.email}>
  <a class="btn btn-ghost btn-sm mb-4" href="/destinations">
    <Icon name="arrow-left" size="sm" /> All destinations
  </a>

  <header class="page-head">
    <div>
      <h1>{label}</h1>
      <div class="dest-row-top mt-3">
        <span class={`pill pill-${status.tone}`}>{status.label}</span>
        <span class="dest-row-meta">{status.hint}</span>
      </div>
    </div>
    <div class="page-actions">
      {
        dest.verified && !dest.active && (
          <form method="post" action={`/destinations/${id}`}>
            <button type="submit" name="_action" value="activate" class="btn btn-primary">
              Set as default
            </button>
          </form>
        )
      }
      {
        !dest.verified && (
          <form method="post" action={`/destinations/${id}`}>
            <button type="submit" name="_action" value="confirm" class="btn btn-accent">
              Confirm &amp; use
            </button>
          </form>
        )
      }
      {dest.active && <a class="btn btn-ghost" href="/keys">Go to API keys</a>}
    </div>
  </header>

  <div class="blocks">
    {error && <p class="callout callout-error" role="alert">{error}</p>}
    {notice && <p class="callout callout-ok" role="status">{notice}</p>}

    {
      !dest.verified && (
        <p class="callout callout-warn" role="status">
          <span class="callout-title">This destination cannot receive money until it is confirmed.</span>
          <span>Confirming checks the numbers and also sets it as your default.</span>
        </p>
      )
    }

    <section class="card">
      <div class="card-head">
        <h2>What happens when a customer pays</h2>
      </div>
      <div class="card-body">
        <p class="lede">{sentence}</p>
      </div>
    </section>

    <section class="card">
      <div class="card-head">
        <h2>Details</h2>
      </div>
      <div class="card-body">
        <dl class="fact-list">
          {facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
          <div>
            <dt>Added</dt>
            <dd>{addedDate(dest.inserted_at)}</dd>
          </div>
        </dl>
      </div>
      <div class="card-foot">
        <a class="btn btn-ghost btn-sm" href="/destinations">All destinations</a>
        <a class="btn btn-ghost btn-sm" href="/destination">Add another</a>
      </div>
    </section>
  </div>
</AppLayout>
