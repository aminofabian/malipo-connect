---
import WizardLayout from "../../layouts/WizardLayout.astro";
import {
  savedDestinationFacts,
  savedDestinationLabel,
  savedDestinationSentence,
  savedDestinationStatus,
} from "../../lib/destination";
import { getDestination, malipoConfigured } from "../../lib/malipo";
import type { SavedDestination } from "../../lib/malipo";
import { requireMerchant } from "../../lib/session";
import { activateSavedDestination, confirmDestination, syncFromService } from "../../lib/store";

export const prerender = false;

const gate = requireMerchant(Astro.cookies, Astro.request);
if (gate instanceof Response) return gate;
const tenantId = gate.businessId;

const { id } = Astro.params;
if (!id) return Astro.redirect("/destinations");

if (!malipoConfigured()) return Astro.redirect("/destinations");

let error: string | null = null;
let notice: string | null = null;
let dest: SavedDestination;

try {
  dest = await getDestination(tenantId, id);
} catch {
  return Astro.redirect("/destinations");
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("_action") ?? "");

  try {
    if (action === "activate") {
      await activateSavedDestination(tenantId, id);
      await syncFromService(tenantId);
      notice = "This destination now receives payments.";
    } else if (action === "confirm") {
      await confirmDestination(tenantId, id);
      await syncFromService(tenantId);
      notice = "Destination confirmed and set to receive payments.";
    }
    dest = await getDestination(tenantId, id);
  } catch (e) {
    error = e instanceof Error ? e.message : "Could not update destination.";
  }
}

const label = savedDestinationLabel(dest);
const status = savedDestinationStatus(dest);
const facts = savedDestinationFacts(dest);
const sentence = savedDestinationSentence(dest);

function addedDate(iso?: string | null): string {
  if (!iso) return "—";
  try {
    return new Date(iso).toLocaleString("en-KE", {
      day: "numeric",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  } catch {
    return "—";
  }
}
---

<WizardLayout title={`${label} · Malipo Connect`} nav current="destinations">
  <a class="note" href="/destinations" style="display:inline-block;margin:0 0 1rem">
    ← All destinations
  </a>

  <h1>{label}</h1>

  <p class="dest-row-top" style="margin:0 0 1.25rem">
    <span class={`status-pill status-${status.tone}`}>{status.label}</span>
    <span class="dest-row-meta">{status.hint}</span>
  </p>

  {error && <p class="err" role="alert">{error}</p>}
  {notice && <p class="note" role="status">{notice}</p>}

  {
    !dest.verified && (
      <p class="warn-once" role="status">
        This destination cannot receive money until it is confirmed. Confirming checks the numbers
        and also sets it as your default.
      </p>
    )
  }

  <div class="actions">
    {
      dest.verified && !dest.active && (
        <form method="post" action={`/destinations/${id}`}>
          <button type="submit" name="_action" value="activate" class="btn btn-primary">
            Set as default
          </button>
        </form>
      )
    }
    {
      !dest.verified && (
        <form method="post" action={`/destinations/${id}`}>
          <button type="submit" name="_action" value="confirm" class="btn btn-teal">
            Confirm &amp; use
          </button>
        </form>
      )
    }
    {dest.active && (
      <a class="btn btn-ghost" href="/keys">
        Go to API keys
      </a>
    )}
    <a class="btn btn-ghost" href="/destinations">All destinations</a>
  </div>

  <div class="confirm-card" style="margin-top:1.5rem">
    <div class="who">What happens when a customer pays</div>
    <p>{sentence}</p>
  </div>

  <section class="settings-block" aria-label="Destination details">
    <h2 class="settings-title">Details</h2>
    <dl class="fact-list">
      {facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
      <div>
        <dt>Added</dt>
        <dd>{addedDate(dest.inserted_at)}</dd>
      </div>
      <div>
        <dt>Status</dt>
        <dd>{status.label}</dd>
      </div>
    </dl>
  </section>
</WizardLayout>
