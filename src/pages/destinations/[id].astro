---
import WizardLayout from "../../layouts/WizardLayout.astro";
import { savedDestinationLabel } from "../../lib/destination";
import { getDestination, malipoConfigured } from "../../lib/malipo";
import { requireMerchant } from "../../lib/session";
import { activateSavedDestination, confirmDestination, syncFromService } from "../../lib/store";

export const prerender = false;

const gate = requireMerchant(Astro.cookies, Astro.request);
if (gate instanceof Response) return gate;
const tenantId = gate.businessId;

const { id } = Astro.params;
if (!id) return Astro.redirect("/destination");

let error: string | null = null;
let notice: string | null = null;
let dest = null;

if (malipoConfigured()) {
  try {
    dest = await getDestination(tenantId, id);
  } catch {
    return Astro.redirect("/destination");
  }
} else {
  return Astro.redirect("/destination");
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("_action") ?? "");

  try {
    if (action === "activate") {
      await activateSavedDestination(tenantId, id);
      await syncFromService(tenantId);
      notice = "This destination is now used for payments.";
      dest = await getDestination(tenantId, id);
    } else if (action === "confirm") {
      await confirmDestination(tenantId, id);
      await syncFromService(tenantId);
      notice = "Destination confirmed and set as in use.";
      dest = await getDestination(tenantId, id);
    }
  } catch (e) {
    error = e instanceof Error ? e.message : "Could not update destination.";
  }
}

const label = savedDestinationLabel(dest);
---

<WizardLayout title={`${label} · Malipo Connect`} step={1} wide>
  <h1>{label}</h1>

  {error && <p class="err" role="alert">{error}</p>}
  {notice && <p class="note" role="status">{notice}</p>}

  <div class="confirm-card">
    <dl class="dest-detail">
      <div>
        <dt>Type</dt>
        <dd>{dest.kind}</dd>
      </div>
      {
        dest.kind === "till" && dest.till_number && (
          <div>
            <dt>Till number</dt>
            <dd class="tabular">{dest.till_number}</dd>
          </div>
        )
      }
      {
        (dest.kind === "paybill" || dest.kind === "bank") && (
          <>
            <div>
              <dt>Paybill</dt>
              <dd class="tabular">{dest.paybill_number}</dd>
            </div>
            <div>
              <dt>Account</dt>
              <dd class="tabular">{dest.account_number}</dd>
            </div>
          </>
        )
      }
      <div>
        <dt>Status</dt>
        <dd>
          {dest.active ? "In use for payments" : dest.verified ? "Saved" : "Awaiting confirmation"}
        </dd>
      </div>
    </dl>
  </div>

  {
    dest.verified && !dest.active && (
      <form method="post" action={`/destinations/${id}`} class="actions">
        <button type="submit" name="_action" value="activate" class="btn btn-primary">
          Use this destination
        </button>
      </form>
    )
  }

  {
    !dest.verified && (
      <>
        <p class="lede">Confirm this destination before it can receive payments.</p>
        <form method="post" action={`/destinations/${id}`} class="actions">
          <button type="submit" name="_action" value="confirm" class="btn btn-primary">
            Confirm destination
          </button>
        </form>
      </>
    )
  }

  <div class="actions">
    <a class="btn btn-ghost" href="/destination">All destinations</a>
    {dest.verified && <a class="btn btn-ghost" href="/keys">API keys</a>}
  </div>
</WizardLayout>

<style>
  .dest-detail {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }
  .dest-detail dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted, #666);
  }
  .dest-detail dd {
    margin: 0.15rem 0 0;
    font-size: 1.05rem;
  }
</style>
