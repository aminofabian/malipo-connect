---
import AppLayout from "../layouts/AppLayout.astro";
import TestPayment from "../islands/TestPayment";
import { getApiMode, requireMerchant } from "../lib/session";
import { syncFromService } from "../lib/store";

export const prerender = false;

const gate = requireMerchant(Astro.cookies, Astro.request);
if (gate instanceof Response) return gate;
const tenantId = gate.businessId;

const mode = getApiMode(Astro.cookies);
const merchant = await syncFromService(tenantId);

// Live testing needs live keys; the sandbox needs nothing.
if (mode === "live" && !merchant.clientId) {
  return Astro.redirect("/destination");
}

const sandbox = mode === "test";

const MIN_KES = 1;
const MAX_KES = 500;

function initialAmount(raw: string | null): string {
  const n = Number.parseInt((raw ?? "").replace(/\D/g, ""), 10);
  if (!Number.isFinite(n) || n < MIN_KES || n > MAX_KES) return "10";
  return String(n);
}

const amount = initialAmount(Astro.url.searchParams.get("amount"));
---

<AppLayout title={sandbox ? "Send a sandbox payment" : "Send a test payment"} section="Payments" step={4} current="keys" email={gate.email}>
  <header class="page-head">
    <div>
      <span class="page-kicker">{sandbox ? "Sandbox" : "Step 4 of 4"}</span>
      <h1>{sandbox ? "Send a sandbox payment" : "Send a test payment"}</h1>
      <p class="lede">
        {
          sandbox
            ? "Pick an outcome and we simulate the whole flow — no phone, no Safaricom, no real money. Settle or fail on demand."
            : "Pay from your phone. You’ll get an M‑Pesa push; when the money reaches your till, paybill, or bank, you know it works. Some banks reject KES 1 — pick an amount they accept."
        }
      </p>
    </div>
    <div class="page-actions">
      <a class="btn btn-ghost" href="/keys">Back to keys</a>
    </div>
  </header>

  <div class="split">
    <TestPayment client:load tenantId={tenantId} initialAmount={amount} mode={mode} />

    <aside class="aside">
      <section class="card">
        <div class="card-head">
          <h2>What happens next</h2>
        </div>
        <div class="card-body">
          {sandbox ? (
            <ol class="flow flow--stack">
              <li>
                <b>01</b>
                <span>We simulate an M‑Pesa prompt against a reserved sandbox number.</span>
              </li>
              <li>
                <b>02</b>
                <span>The payment settles or fails — whichever outcome you picked.</span>
              </li>
              <li>
                <b>03</b>
                <span>Your webhook fires, signed with the test secret, so you can verify your handler.</span>
              </li>
            </ol>
          ) : (
            <ol class="flow flow--stack">
              <li>
                <b>01</b>
                <span>We send an M‑Pesa prompt to your phone.</span>
              </li>
              <li>
                <b>02</b>
                <span>You enter your PIN and approve the payment.</span>
              </li>
              <li>
                <b>03</b>
                <span>The money lands in your destination and this page confirms it.</span>
              </li>
            </ol>
          )}
        </div>
      </section>

      <div class="soft">
        <p class="section-kicker">{sandbox ? "No money moves" : "If it fails"}</p>
        <p class="note">
          {
            sandbox ? (
              <>
                Sandbox payments never touch Safaricom and never charge anyone. Switch off{" "}
                <strong>Test mode</strong> to take real payments.
              </>
            ) : (
              <>
                Some banks reject very small amounts. Try KES 10, and check that your destination is
                confirmed and set as default on the <a href="/destinations">Destinations</a> page.
              </>
            )
          }
        </p>
      </div>
    </aside>
  </div>
</AppLayout>
