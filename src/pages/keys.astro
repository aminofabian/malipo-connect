---
import AppLayout from "../layouts/AppLayout.astro";
import { destinationLabel } from "../lib/destination";
import { getApiMode, requireMerchant, setOnceSecrets, takeOnceSecrets } from "../lib/session";
import {
  getSummary,
  listRecentPayments,
  provisionKeys,
  publicApiBase,
  resetTestData,
  syncFromService,
} from "../lib/store";

export const prerender = false;

const gate = requireMerchant(Astro.cookies, Astro.request);
if (gate instanceof Response) return gate;
const tenantId = gate.businessId;

const mode = getApiMode(Astro.cookies);
const sandbox = mode === "test";

let merchant = await syncFromService(tenantId);
let once = takeOnceSecrets(Astro.cookies);
let error: string | null = null;
let notice: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");

  try {
    if (action === "rotate") {
      const secrets = await provisionKeys(tenantId, mode);
      setOnceSecrets(Astro.cookies, secrets);
      once = secrets;
      notice = sandbox ? "New sandbox key issued." : "New key issued.";
      merchant = await syncFromService(tenantId);
    } else if (action === "reset") {
      await resetTestData(tenantId);
      notice = "Sandbox data cleared.";
      merchant = await syncFromService(tenantId);
    }
  } catch (e) {
    error = e instanceof Error ? e.message : "Could not complete that action.";
  }
}

const keyId = sandbox ? merchant.testClientId : merchant.clientId;
const hasKey = Boolean(keyId);

// Live collections need a destination; the sandbox needs none (D5).
if (!sandbox && (!hasKey || !merchant.destination)) {
  return Astro.redirect("/destination");
}

const base = publicApiBase();
const dest = merchant.destination ? destinationLabel(merchant.destination) : "your account";

const scope = Astro.url.searchParams.get("scope") === "all" ? "all" : "this";
const activeId = merchant.destinationId;

const allPayments = await listRecentPayments(tenantId, 15, mode);
const payments =
  scope === "this" && activeId
    ? allPayments.filter((p) => p.destination_id === activeId)
    : allPayments;

// Sandbox totals are not money; only the live view reports settled volume.
const summary = sandbox ? null : await getSummary(tenantId);
const scopeTotal =
  scope === "this" && activeId
    ? summary?.by_destination.find((row) => row.destination_id === activeId)
    : null;

const prefix = sandbox ? "sk_test_" : "sk_live_";
const pkPrefix = sandbox ? "pk_test_" : "pk_live_";

function kes(amount: string): string {
  const n = Number(amount);
  if (!Number.isFinite(n)) return `KES ${amount}`;
  return `KES ${n.toLocaleString("en-KE", {
    minimumFractionDigits: n % 1 === 0 ? 0 : 2,
    maximumFractionDigits: 2,
  })}`;
}
const chargeRequest = once
  ? `curl -X POST ${base}/v1/payments \\
  -H "Authorization: Bearer ${once.clientSecret}" \\
  -H "Content-Type: application/json" \\
  -d '{"amount":"100.00","customer_phone":"254712345678","reference":"order-1042","idempotency_key":"order-1042-1","callback_url":"https://your-app.example/paid"}'`
  : "";

function statusLabel(s: string) {
  if (s === "settled") return "settled";
  if (s === "failed" || s === "expired") return "failed";
  if (s === "prompted") return "prompted";
  return s;
}

function when(iso: string | null | undefined) {
  if (!iso) return "—";
  try {
    const d = new Date(iso);
    return d.toLocaleString("en-KE", {
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  } catch {
    return iso;
  }
}
---

<AppLayout
  title={sandbox ? "Sandbox keys" : "Keys & requests"}
  section="Payments"
  step={3}
  current="keys"
  email={gate.email}
>
  <header class="page-head">
    <div>
      <span class="page-kicker">{sandbox ? "Sandbox" : "Step 3 of 4"}</span>
      <h1>{sandbox ? "Charge in sandbox" : "Charge a phone"}</h1>
      <p class="lede">
        {
          sandbox
            ? "Test keys for the KioskPay API. Send simulated payments and receive real, signed webhooks — no money moves."
            : `Money goes to ${dest}. Copy this request — the customer's phone gets an M‑Pesa prompt.`
        }
      </p>
    </div>
    <div class="page-actions">
      {!sandbox && <a class="btn btn-ghost" href="/destination">Change destination</a>}
      <a class="btn btn-ghost" href="/test">Send a test</a>
    </div>
  </header>

  <div class="split">
    <div class="blocks">
      {error && <p class="callout callout-error" role="alert">{error}</p>}
      {notice && <p class="callout callout-ok" role="status">{notice}</p>}

      {
        !hasKey ? (
          <section class="card">
            <div class="card-head">
              <h2>Sandbox keys</h2>
            </div>
            <div class="card-body">
              <p class="note">
                Generate test keys to call the API in sandbox mode. No destination and no Safaricom
                account needed.
              </p>
            </div>
            <form method="post" action="/keys" class="card-foot">
              <input type="hidden" name="action" value="rotate" />
              <button type="submit" class="btn btn-accent">
                Create sandbox keys
              </button>
            </form>
          </section>
        ) : once ? (
          <>
            <p class="callout callout-warn" role="status">
              <span class="callout-title">
                {notice === "New key issued." || notice === "New sandbox key issued."
                  ? "New key issued. "
                  : ""}Copy this now.
              </span>
              <span>Refreshing the page hides the key forever.</span>
            </p>

            <section class="card">
              <div class="card-head">
                <h2>Your charge request</h2>
                <button type="button" class="btn btn-accent btn-sm" data-copy-btn={chargeRequest}>
                  Copy request
                </button>
              </div>
              <div class="card-body card-body-flush">
                <pre class="snippet">{chargeRequest}</pre>
              </div>
              <div class="card-foot">
                <p class="note">
                  Use a new <code>idempotency_key</code> for each payment. Put your server on{" "}
                  <code>callback_url</code>, or confirm with <code>GET</code> when the result matters.{" "}
                  <a href="/guide">Read the guide</a>.
                </p>
              </div>
            </section>

            <section class="card">
              <div class="card-head">
                <h2>Webhook signing secret</h2>
                <button type="button" class="btn btn-ghost btn-sm" data-copy-btn={once.webhookSecret}>
                  Copy
                </button>
              </div>
              <div class="card-body">
                <p class="note mb-3">
                  We sign every callback with this secret (<code>X-Malipo-Signature</code>). Keep it
                  on your server. Verify it, or just confirm with <code>GET</code>.{" "}
                  <a href="/guide#verify">How to verify</a>.
                </p>
                <div class="copy-list">
                  <div class="copy-row">
                    <span class="copy-row-label">Signing secret</span>
                    <span class="copy-row-value">
                      <code>{once.webhookSecret}</code>
                    </span>
                  </div>
                </div>
              </div>
            </section>
          </>
        ) : (
          <div class="card">
            <div class="card-head">
              <h2>Your charge request</h2>
            </div>
            <div class="card-body">
              <p class="note">
                This key was already shown. Rotate below to copy a new request — the old key stops
                working immediately. <a href="/guide">Read the guide</a>.
              </p>
            </div>
          </div>
        )
      }

      <section class="card card-flush" aria-label="Recent payments">
        <div class="card-head">
          <h2>{sandbox ? "Recent sandbox payments" : "Recent payments"}</h2>
          {
            activeId && !sandbox && (
              <div class="segmented" role="group" aria-label="Payment scope">
                <a
                  class:list={[{ on: scope === "this" }]}
                  href="/keys"
                  aria-current={scope === "this" ? "true" : undefined}
                >
                  This destination
                </a>
                <a
                  class:list={[{ on: scope === "all" }]}
                  href="/keys?scope=all"
                  aria-current={scope === "all" ? "true" : undefined}
                >
                  All
                </a>
              </div>
            )
          }
        </div>

        {
          scopeTotal && (
            <div class="card-body card-body-tight divide-b">
              <span class="figure">
                <span class="figure-value">{kes(scopeTotal.total)}</span>
                <span class="figure-label">
                  received to this destination across {scopeTotal.count} payment
                  {scopeTotal.count === 1 ? "" : "s"}
                </span>
              </span>
            </div>
          )
        }

        {
          payments.length === 0 ? (
            <div class="card-body">
              <p class="note">
                {sandbox
                  ? "No sandbox payments yet. Send one to see it here."
                  : scope === "this"
                    ? "No payments recorded for this destination yet."
                    : "No payments yet. Send a test or create a payment."}
              </p>
            </div>
          ) : (
            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">Status</th>
                    <th scope="col">Amount</th>
                    <th scope="col">Reference</th>
                    <th scope="col">When</th>
                  </tr>
                </thead>
                <tbody>
                  {payments.map((p) => (
                    <tr>
                      <td>
                        <span class={`pill pill-${statusLabel(p.status)}`}>
                          {statusLabel(p.status)}
                        </span>
                      </td>
                      <td class="table-amount">
                        {p.amount} {p.currency}
                      </td>
                      <td class="table-ref">{p.reference || p.id.slice(0, 8)}</td>
                      <td class="table-when">{when(p.inserted_at)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }

        {
          sandbox && payments.length > 0 && (
            <form method="post" action="/keys" class="card-foot">
              <input type="hidden" name="action" value="reset" />
              <p class="note">Clears every sandbox payment and event. Live data is untouched.</p>
              <button type="submit" class="btn btn-danger-ghost btn-sm">
                Reset sandbox data
              </button>
            </form>
          )
        }
      </section>
    </div>

    <aside class="aside">
      <section class="card">
        <div class="card-head">
          <h2>Integration details</h2>
        </div>
        <div class="card-body card-body-flush">
          <div class="copy-list copy-list--bare">
            <div class="copy-row">
              <span class="copy-row-label">Client ID</span>
              <span class="copy-row-value">
                <code>{keyId ?? "— not issued yet —"}</code>
                {
                  keyId && (
                    <button type="button" class="btn btn-ghost btn-sm" data-copy-btn={keyId}>
                      Copy
                    </button>
                  )
                }
              </span>
            </div>
            <div class="copy-row">
              <span class="copy-row-label">Endpoint base URL</span>
              <span class="copy-row-value">
                <code>{base}</code>
                <button type="button" class="btn btn-ghost btn-sm" data-copy-btn={base}>
                  Copy
                </button>
              </span>
            </div>
          </div>
        </div>
        {
          hasKey && (
            <form method="post" action="/keys" class="card-foot">
              <input type="hidden" name="action" value="rotate" />
              <p class="note">
                {sandbox
                  ? "Issues a new sandbox client secret. The old one stops working immediately."
                  : "Issues a new client secret. The old one stops working immediately."}
              </p>
              <button type="submit" class="btn btn-danger-ghost btn-sm">
                {sandbox ? "Rotate sandbox key" : "Rotate key"}
              </button>
            </form>
          )
        }
      </section>

      <section class="card">
        <div class="card-head">
          <h2>Endpoints</h2>
        </div>
        <div class="card-body card-body-tight">
          <ul class="endpoint-list">
            <li>
              <span class="method method-post">POST</span>
              <code>/v1/payments</code>
              <span class="endpoint-what">Start a payment.</span>
            </li>
            <li>
              <span class="method method-get">GET</span>
              <code>/v1/payments/{"{id}"}</code>
              <span class="endpoint-what">Check until it settles.</span>
            </li>
            {
              sandbox && (
                <li>
                  <span class="method method-post">POST</span>
                  <code>/v1/payments/{"{id}"}/simulate</code>
                  <span class="endpoint-what">Force settled / failed.</span>
                </li>
              )
            }
          </ul>
        </div>
      </section>

      <section class="card">
        <div class="card-head">
          <h2>Send a test payment</h2>
        </div>
        <div class="card-body">
          <p class="note mb-3">
            {sandbox
              ? "Pick an outcome and simulate the flow — no phone needed."
              : "Pay from your phone to prove the whole thing works. Some banks reject KES 1."}
          </p>
          <form method="get" action="/test" class="row gap-2">
            <div class="field field-grow">
              <label for="test-amount" class="sr-only">Amount (KES)</label>
              <input
                id="test-amount"
                name="amount"
                inputmode="numeric"
                autocomplete="off"
                value="10"
                maxlength="3"
              />
            </div>
            <button type="submit" class="btn btn-accent">Send test</button>
          </form>
        </div>
      </section>

      <details class="explainer">
        <summary>Which key is which?</summary>
        <div class="explainer-body">
          <p>
            <strong>Client secret</strong> (<code>{prefix}…</code>) authenticates your server on every
            request. <strong>Webhook signing secret</strong> (<code>{sandbox ? "whsec_test_" : "whsec_"}…</code>) proves a
            callback really came from Malipo. Both are shown once, when they are issued.
          </p>
          <p>
            The <strong>client ID</strong> (<code>{pkPrefix}…</code>) is not a secret — it is safe to
            keep in your configuration and is shown here any time.
          </p>
        </div>
      </details>

      <details class="explainer">
        <summary>Skip callback_url?</summary>
        <div class="explainer-body">
          <p>
            Save your website URL once in <a href="/settings">Settings</a> and we POST results there
            by default, instead of you sending <code>callback_url</code> on every request.
          </p>
        </div>
      </details>
    </aside>
  </div>
</AppLayout>

<script>
  document.querySelectorAll("[data-copy-btn]").forEach((btn) => {
    const label = btn.textContent ?? "Copy";
    btn.addEventListener("click", async () => {
      const text = btn.getAttribute("data-copy-btn") ?? "";
      try {
        await navigator.clipboard.writeText(text);
        btn.classList.add("is-copied");
        btn.textContent = "Copied";
        setTimeout(() => {
          btn.classList.remove("is-copied");
          btn.textContent = label;
        }, 1200);
      } catch {
        const span = btn.previousElementSibling;
        if (span) {
          const range = document.createRange();
          range.selectNodeContents(span);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
      }
    });
  });
</script>
