---
import WizardLayout from "../layouts/WizardLayout.astro";
import { destinationLabel } from "../lib/destination";
import { requireMerchant, setOnceSecrets, takeOnceSecrets } from "../lib/session";
import {
  getSummary,
  listRecentPayments,
  provisionKeys,
  publicApiBase,
  syncFromService,
} from "../lib/store";

export const prerender = false;

const gate = requireMerchant(Astro.cookies, Astro.request);
if (gate instanceof Response) return gate;
const tenantId = gate.businessId;

let merchant = await syncFromService(tenantId);
let once = takeOnceSecrets(Astro.cookies);
let rotateError: string | null = null;
let rotated = false;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");

  if (action === "rotate") {
    try {
      const secrets = await provisionKeys(tenantId);
      setOnceSecrets(Astro.cookies, secrets);
      once = secrets;
      rotated = true;
      merchant = await syncFromService(tenantId);
    } catch (e) {
      rotateError = e instanceof Error ? e.message : "Could not rotate keys.";
    }
  }
}

if (!merchant.clientId || !merchant.destination) {
  return Astro.redirect("/destination");
}

const base = publicApiBase();
const dest = destinationLabel(merchant.destination);

const scope = Astro.url.searchParams.get("scope") === "all" ? "all" : "this";
const activeId = merchant.destinationId;

const allPayments = await listRecentPayments(tenantId, 15);
const payments =
  scope === "this" && activeId
    ? allPayments.filter((p) => p.destination_id === activeId)
    : allPayments;

const summary = await getSummary(tenantId);
const scopeTotal =
  scope === "this" && activeId
    ? summary?.by_destination.find((row) => row.destination_id === activeId)
    : null;

function kes(amount: string): string {
  const n = Number(amount);
  if (!Number.isFinite(n)) return `KES ${amount}`;
  return `KES ${n.toLocaleString("en-KE", {
    minimumFractionDigits: n % 1 === 0 ? 0 : 2,
    maximumFractionDigits: 2,
  })}`;
}
const chargeRequest = once
  ? `curl -X POST ${base}/v1/payments \\
  -H "Authorization: Bearer ${once.clientSecret}" \\
  -H "Content-Type: application/json" \\
  -d '{"amount":"100.00","customer_phone":"254712345678","reference":"order-1042","idempotency_key":"order-1042-1","callback_url":"https://your-app.example/paid"}'`
  : "";

function statusLabel(s: string) {
  if (s === "settled") return "settled";
  if (s === "failed" || s === "expired") return "failed";
  if (s === "prompted") return "prompted";
  return s;
}

function when(iso: string | null | undefined) {
  if (!iso) return "—";
  try {
    const d = new Date(iso);
    return d.toLocaleString("en-KE", {
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  } catch {
    return iso;
  }
}
---

<WizardLayout title="Charge a phone · Malipo Connect" step={3} nav current="keys">
  <h1>Charge a phone</h1>
  <p class="lede">
    Money goes to <strong>{dest}</strong>. Copy this request. The customer's phone gets an M-Pesa
    prompt.
  </p>

  {
    once ? (
      <>
        <p class="warn-once" role="status">
          {rotated ? "New key issued. " : ""}
          Copy this now. Refreshing the page hides the key forever.
        </p>
        <pre class="snippet">{chargeRequest}</pre>
        <button type="button" class="btn btn-accent" data-copy-btn={chargeRequest}>
          Copy request
        </button>
        <p class="note">
          Use a new <code>idempotency_key</code> for each payment. Put your server on
          <code>callback_url</code>. When the customer pays or cancels, we POST there. Then
          <code>GET {base}/v1/payments/{"{id}"}</code> with the same key and use that response.
          <a href="/guide">Read the guide</a>.
        </p>
        <div class="copy-row">
          <span class="label">Webhook signing secret</span>
          <span class="value">
            <code>{once.webhookSecret}</code>
            <button type="button" data-copy-btn={once.webhookSecret}>Copy</button>
          </span>
        </div>
        <p class="note">
          We sign every callback with this secret (<code>X-Malipo-Signature</code>). Keep it on your
          server. Verify it, or just confirm with <code>GET</code>.
          <a href="/guide#verify">How to verify</a>.
        </p>
        <p class="note">
          Would rather not send <code>callback_url</code> on every request? Save your website URL once
          in <a href="/settings">Settings</a> and we POST results there by default.
        </p>
      </>
    ) : (
      <p class="note">
        This key was already shown. Rotate below to copy a new request. The old key stops working
        immediately. <a href="/guide">Read the guide</a>.
      </p>
    )
  }

  <section class="settings-block" aria-label="Your integration details">
    <h2 class="settings-title">Your integration details</h2>
    <p class="settings-hint">
      These stay the same between payments. Copy them into your website or app.
    </p>

    <div class="copy-row">
      <span class="label">Client ID</span>
      <span class="value">
        <code>{merchant.clientId}</code>
        <button type="button" data-copy-btn={merchant.clientId}>Copy</button>
      </span>
    </div>

    <div class="copy-row">
      <span class="label">Endpoint base URL</span>
      <span class="value">
        <code>{base}</code>
        <button type="button" data-copy-btn={base}>Copy</button>
      </span>
    </div>

    <div class="copy-row">
      <span class="label">Create a payment</span>
      <span class="value"><code>POST {base}/v1/payments</code></span>
    </div>

    <div class="copy-row">
      <span class="label">Check a payment</span>
      <span class="value"><code>GET {base}/v1/payments/{"{id}"}</code></span>
    </div>

    <div class="actions">
      <a class="btn btn-ghost" href="/settings">Settings &amp; website URL</a>
      <a class="btn btn-ghost" href="/guide">Guide</a>
    </div>

    <details class="explainer">
      <summary>Which key is which?</summary>
      <p>
        <strong>Client secret</strong> (<code>sk_live_…</code>) authenticates your server on every
        request. <strong>Webhook signing secret</strong> (<code>whsec_…</code>) proves a callback
        really came from Malipo. Both are shown once, when they are issued.
      </p>
      <p>
        The <strong>client ID</strong> (<code>pk_live_…</code>) is not a secret — it is safe to keep
        in your configuration and is shown here any time.
      </p>
    </details>
  </section>

  <section class="recent" aria-label="Recent payments">
    <div class="recent-head">
      <h2 class="recent-title">Recent payments</h2>
      {
        activeId && (
          <div class="scope-toggle" role="group" aria-label="Payment scope">
            <a
              class:list={["scope-link", { "scope-on": scope === "this" }]}
              href="/keys"
              aria-current={scope === "this" ? "true" : undefined}
            >
              This destination
            </a>
            <a
              class:list={["scope-link", { "scope-on": scope === "all" }]}
              href="/keys?scope=all"
              aria-current={scope === "all" ? "true" : undefined}
            >
              All
            </a>
          </div>
        )
      }
    </div>

    {
      scopeTotal && (
        <p class="note" style="margin-top:0">
          Received <strong>{kes(scopeTotal.total)}</strong> to this destination across
          {" "}
          {scopeTotal.count} payment{scopeTotal.count === 1 ? "" : "s"}.
        </p>
      )
    }

    {
      payments.length === 0 ? (
        <p class="note">
          {scope === "this"
            ? "No payments recorded for this destination yet."
            : "No payments yet. Send a test or create a payment."}
        </p>
      ) : (
        <ul class="recent-list">
          {payments.map((p) => (
            <li>
              <span class={`pill pill-${statusLabel(p.status)}`}>{statusLabel(p.status)}</span>
              <span class="recent-amt">
                {p.amount} {p.currency}
              </span>
              <span class="recent-ref">{p.reference || p.id.slice(0, 8)}</span>
              <span class="recent-when">{when(p.inserted_at)}</span>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="settings-block" aria-label="Send a test payment">
    <h2 class="settings-title">Send a test payment</h2>
    <p class="settings-hint">
      Pay from your phone to prove the whole thing works. Some banks reject KES 1 — enter whatever
      amount they accept.
    </p>

    <form method="get" action="/test" class="test-jump">
      <div class="field">
        <label for="test-amount">Amount (KES)</label>
        <input
          id="test-amount"
          name="amount"
          inputmode="numeric"
          autocomplete="off"
          value="10"
          maxlength="3"
        />
      </div>
      <button type="submit" class="btn btn-accent">Send test</button>
    </form>
  </section>

  <div class="actions">
    <a class="btn btn-ghost" href="/destination">Change destination</a>
    <a class="btn btn-ghost" href="/destinations">Destinations</a>
  </div>

  <form method="post" action="/keys" class="rotate-form">
    <input type="hidden" name="action" value="rotate" />
    {rotateError && <p class="err" role="alert">{rotateError}</p>}
    <p class="note">Lost the request? Rotate issues a new key. The old key stops immediately.</p>
    <button type="submit" class="btn btn-ghost">Rotate key</button>
  </form>
</WizardLayout>

<style>
  .snippet {
    margin: 0.85rem 0;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    border-radius: 14px;
    background: #111;
    color: var(--yellow);
    box-shadow: var(--shadow-sm);
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.6;
    white-space: pre-wrap;
  }
</style>

<script>
  document.querySelectorAll("[data-copy-btn]").forEach((btn) => {
    const label = btn.textContent ?? "Copy";
    btn.addEventListener("click", async () => {
      const text = btn.getAttribute("data-copy-btn") ?? "";
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = "Copied";
        setTimeout(() => (btn.textContent = label), 1200);
      } catch {
        const span = btn.previousElementSibling;
        if (span) {
          const range = document.createRange();
          range.selectNodeContents(span);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
      }
    });
  });
</script>
