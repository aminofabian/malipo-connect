---
import AppLayout from "../layouts/AppLayout.astro";
import { destinationLabel } from "../lib/destination";
import { requireMerchant, setOnceSecrets, takeOnceSecrets } from "../lib/session";
import {
  getSummary,
  listRecentPayments,
  provisionKeys,
  publicApiBase,
  syncFromService,
} from "../lib/store";

export const prerender = false;

const gate = requireMerchant(Astro.cookies, Astro.request);
if (gate instanceof Response) return gate;
const tenantId = gate.businessId;

let merchant = await syncFromService(tenantId);
let once = takeOnceSecrets(Astro.cookies);
let rotateError: string | null = null;
let rotated = false;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");

  if (action === "rotate") {
    try {
      const secrets = await provisionKeys(tenantId);
      setOnceSecrets(Astro.cookies, secrets);
      once = secrets;
      rotated = true;
      merchant = await syncFromService(tenantId);
    } catch (e) {
      rotateError = e instanceof Error ? e.message : "Could not rotate keys.";
    }
  }
}

if (!merchant.clientId || !merchant.destination) {
  return Astro.redirect("/destination");
}

const base = publicApiBase();
const dest = destinationLabel(merchant.destination);

const scope = Astro.url.searchParams.get("scope") === "all" ? "all" : "this";
const activeId = merchant.destinationId;

const allPayments = await listRecentPayments(tenantId, 15);
const payments =
  scope === "this" && activeId
    ? allPayments.filter((p) => p.destination_id === activeId)
    : allPayments;

const summary = await getSummary(tenantId);
const scopeTotal =
  scope === "this" && activeId
    ? summary?.by_destination.find((row) => row.destination_id === activeId)
    : null;

function kes(amount: string): string {
  const n = Number(amount);
  if (!Number.isFinite(n)) return `KES ${amount}`;
  return `KES ${n.toLocaleString("en-KE", {
    minimumFractionDigits: n % 1 === 0 ? 0 : 2,
    maximumFractionDigits: 2,
  })}`;
}
const chargeRequest = once
  ? `curl -X POST ${base}/v1/payments \\
  -H "Authorization: Bearer ${once.clientSecret}" \\
  -H "Content-Type: application/json" \\
  -d '{"amount":"100.00","customer_phone":"254712345678","reference":"order-1042","idempotency_key":"order-1042-1","callback_url":"https://your-app.example/paid"}'`
  : "";

function statusLabel(s: string) {
  if (s === "settled") return "settled";
  if (s === "failed" || s === "expired") return "failed";
  if (s === "prompted") return "prompted";
  return s;
}

function when(iso: string | null | undefined) {
  if (!iso) return "—";
  try {
    const d = new Date(iso);
    return d.toLocaleString("en-KE", {
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  } catch {
    return iso;
  }
}
---

<AppLayout title="Keys & requests" section="Payments" step={3} current="keys" email={gate.email}>
  <header class="page-head">
    <div>
      <span class="page-kicker">Step 3 of 4</span>
      <h1>Charge a phone</h1>
      <p class="lede">
        Money goes to <strong>{dest}</strong>. Copy this request — the customer's phone gets an
        M-Pesa prompt.
      </p>
    </div>
    <div class="page-actions">
      <a class="btn btn-ghost" href="/destination">Change destination</a>
      <a class="btn btn-ghost" href="/test">Send a test</a>
    </div>
  </header>

  <div class="split">
    <div class="blocks">
      {
        once ? (
          <>
            <p class="callout callout-warn" role="status">
              <span class="callout-title">
                {rotated ? "New key issued. " : ""}Copy this now.
              </span>
              <span style="font-weight: 400">Refreshing the page hides the key forever.</span>
            </p>

            <section class="card">
              <div class="card-head">
                <h2>Your charge request</h2>
                <button type="button" class="btn btn-accent btn-sm" data-copy-btn={chargeRequest}>
                  Copy request
                </button>
              </div>
              <div class="card-body" style="padding: 0">
                <pre class="snippet">{chargeRequest}</pre>
              </div>
              <div class="card-foot">
                <p class="note">
                  Use a new <code>idempotency_key</code> for each payment. Put your server on{" "}
                  <code>callback_url</code>, or confirm with <code>GET</code> when the result matters.{" "}
                  <a href="/guide">Read the guide</a>.
                </p>
              </div>
            </section>

            <section class="card">
              <div class="card-head">
                <h2>Webhook signing secret</h2>
                <button type="button" class="btn btn-ghost btn-sm" data-copy-btn={once.webhookSecret}>
                  Copy
                </button>
              </div>
              <div class="card-body">
                <p class="note" style="margin-bottom: var(--s3)">
                  We sign every callback with this secret (<code>X-Malipo-Signature</code>). Keep it
                  on your server. Verify it, or just confirm with <code>GET</code>.{" "}
                  <a href="/guide#verify">How to verify</a>.
                </p>
                <div class="copy-list">
                  <div class="copy-row">
                    <span class="copy-row-label">Signing secret</span>
                    <span class="copy-row-value">
                      <code>{once.webhookSecret}</code>
                    </span>
                  </div>
                </div>
              </div>
            </section>
          </>
        ) : (
          <div class="card">
            <div class="card-head">
              <h2>Your charge request</h2>
            </div>
            <div class="card-body">
              <p class="note">
                This key was already shown. Rotate below to copy a new request — the old key stops
                working immediately. <a href="/guide">Read the guide</a>.
              </p>
            </div>
          </div>
        )
      }

      <section class="card card-flush" aria-label="Recent payments">
        <div class="card-head">
          <h2>Recent payments</h2>
          {
            activeId && (
              <div class="segmented" role="group" aria-label="Payment scope">
                <a
                  class:list={[{ on: scope === "this" }]}
                  href="/keys"
                  aria-current={scope === "this" ? "true" : undefined}
                >
                  This destination
                </a>
                <a
                  class:list={[{ on: scope === "all" }]}
                  href="/keys?scope=all"
                  aria-current={scope === "all" ? "true" : undefined}
                >
                  All
                </a>
              </div>
            )
          }
        </div>

        {
          scopeTotal && (
            <div class="card-body card-body-tight" style="border-bottom: 1px solid var(--line-soft)">
              <span class="figure">
                <span class="figure-value">{kes(scopeTotal.total)}</span>
                <span class="figure-label">
                  received to this destination across {scopeTotal.count} payment
                  {scopeTotal.count === 1 ? "" : "s"}
                </span>
              </span>
            </div>
          )
        }

        {
          payments.length === 0 ? (
            <div class="card-body">
              <p class="note">
                {scope === "this"
                  ? "No payments recorded for this destination yet."
                  : "No payments yet. Send a test or create a payment."}
              </p>
            </div>
          ) : (
            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">Status</th>
                    <th scope="col">Amount</th>
                    <th scope="col">Reference</th>
                    <th scope="col">When</th>
                  </tr>
                </thead>
                <tbody>
                  {payments.map((p) => (
                    <tr>
                      <td>
                        <span class={`pill pill-${statusLabel(p.status)}`}>
                          {statusLabel(p.status)}
                        </span>
                      </td>
                      <td class="table-amount">
                        {p.amount} {p.currency}
                      </td>
                      <td class="table-ref">{p.reference || p.id.slice(0, 8)}</td>
                      <td class="table-when">{when(p.inserted_at)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </section>
    </div>

    <aside class="aside">
      <section class="card">
        <div class="card-head">
          <h2>Integration details</h2>
        </div>
        <div style="padding: 0">
          <div class="copy-list" style="border: 0">
            <div class="copy-row">
              <span class="copy-row-label">Client ID</span>
              <span class="copy-row-value">
                <code>{merchant.clientId}</code>
                <button type="button" class="btn btn-ghost btn-sm" data-copy-btn={merchant.clientId}>
                  Copy
                </button>
              </span>
            </div>
            <div class="copy-row">
              <span class="copy-row-label">Endpoint base URL</span>
              <span class="copy-row-value">
                <code>{base}</code>
                <button type="button" class="btn btn-ghost btn-sm" data-copy-btn={base}>
                  Copy
                </button>
              </span>
            </div>
          </div>
        </div>
      </section>

      <section class="card">
        <div class="card-head">
          <h2>Endpoints</h2>
        </div>
        <div class="card-body card-body-tight">
          <ul class="endpoint-list">
            <li>
              <span class="method method-post">POST</span>
              <code>/v1/payments</code>
              <span class="endpoint-what">Start a payment.</span>
            </li>
            <li>
              <span class="method method-get">GET</span>
              <code>/v1/payments/{"{id}"}</code>
              <span class="endpoint-what">Check until it settles.</span>
            </li>
          </ul>
        </div>
      </section>

      <section class="card">
        <div class="card-head">
          <h2>Send a test payment</h2>
        </div>
        <div class="card-body">
          <p class="note" style="margin-bottom: var(--s3)">
            Pay from your phone to prove the whole thing works. Some banks reject KES 1.
          </p>
          <form method="get" action="/test" class="row" style="gap: var(--s2)">
            <div class="field" style="flex: 1 1 6rem">
              <label for="test-amount" class="sr-only">Amount (KES)</label>
              <input
                id="test-amount"
                name="amount"
                inputmode="numeric"
                autocomplete="off"
                value="10"
                maxlength="3"
              />
            </div>
            <button type="submit" class="btn btn-accent">Send test</button>
          </form>
        </div>
      </section>

      <details class="explainer">
        <summary>Which key is which?</summary>
        <div class="explainer-body">
          <p>
            <strong>Client secret</strong> (<code>sk_live_…</code>) authenticates your server on
            every request. <strong>Webhook signing secret</strong> (<code>whsec_…</code>) proves a
            callback really came from Malipo. Both are shown once, when they are issued.
          </p>
          <p>
            The <strong>client ID</strong> (<code>pk_live_…</code>) is not a secret — it is safe to
            keep in your configuration and is shown here any time.
          </p>
        </div>
      </details>

      <details class="explainer">
        <summary>Skip callback_url?</summary>
        <div class="explainer-body">
          <p>
            Save your website URL once in <a href="/settings">Settings</a> and we POST results there
            by default, instead of you sending <code>callback_url</code> on every request.
          </p>
        </div>
      </details>
    </aside>
  </div>

  <div class="actions" style="margin-top: var(--s7)">
    <a class="btn btn-ghost" href="/destinations">Destinations</a>
    <form method="post" action="/keys">
      <input type="hidden" name="action" value="rotate" />
      {rotateError && <p class="callout callout-error" role="alert">{rotateError}</p>}
      <button type="submit" class="btn btn-ghost">Rotate key</button>
    </form>
  </div>
</AppLayout>

<script>
  document.querySelectorAll("[data-copy-btn]").forEach((btn) => {
    const label = btn.textContent ?? "Copy";
    btn.addEventListener("click", async () => {
      const text = btn.getAttribute("data-copy-btn") ?? "";
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = "Copied";
        setTimeout(() => (btn.textContent = label), 1200);
      } catch {
        const span = btn.previousElementSibling;
        if (span) {
          const range = document.createRange();
          range.selectNodeContents(span);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
      }
    });
  });
</script>
