---
import "@fontsource-variable/sora";
import "../styles/tokens.css";

interface Props {
  title?: string;
  step?: 1 | 2 | 3 | 4;
  wide?: boolean;
  nav?: boolean;
  current?: "home" | "destinations" | "keys" | "settings";
}

const { title = "Malipo Connect", step, wide = false, nav = false, current } = Astro.props;

const links = [
  { key: "home", href: "/", label: "Home" },
  { key: "destinations", href: "/destinations", label: "Destinations" },
  { key: "keys", href: "/keys", label: "Keys" },
  { key: "settings", href: "/settings", label: "Settings" },
] as const;
---

<!doctype html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Add a till, paybill, or bank to receive M-Pesa payments. Customers get a push; money goes to you. Copy one request to charge a phone."
    />
    <title>{title}</title>
  </head>
  <body>
    <div class:list={["shell", { "shell-wide": wide }]}>
      <a class="brand" href="/">
        <strong>Malipo Connect</strong>
        <span class="brand-tag">
          <span id="svc-dot" class="svc-dot" data-state="unknown" aria-hidden="true"></span>
          payments setup
        </span>
      </a>

      <div id="svc-banner" class="svc-banner" role="status" aria-live="polite" hidden>
        <div class="svc-banner-text">
          <strong>Payments service is degraded.</strong>
          <span>Some steps may not save or load right now. Please try again shortly.</span>
        </div>
        <button type="button" class="svc-dismiss" data-dismiss aria-label="Dismiss">
          <span aria-hidden="true">×</span>
        </button>
      </div>

      {
        nav && (
          <nav class="appnav" aria-label="Account">
            {links.map((link) => (
              <a
                class:list={["navlink", { "navlink-on": current === link.key }]}
                href={link.href}
                aria-current={current === link.key ? "page" : undefined}
              >
                {link.label}
              </a>
            ))}
            <a class="navlink navlink-out" href="/api/session/logout">
              Sign out
            </a>
          </nav>
        )
      }

      {
        step != null && (
          <ol class="steps" aria-label="Setup progress">
            <li data-on={step >= 1} aria-current={step === 1 ? "step" : undefined}>
              <b>1</b>
              <span>Destination</span>
            </li>
            <li data-on={step >= 2} aria-current={step === 2 ? "step" : undefined}>
              <b>2</b>
              <span>Confirm</span>
            </li>
            <li data-on={step >= 3} aria-current={step === 3 ? "step" : undefined}>
              <b>3</b>
              <span>Keys</span>
            </li>
            <li data-on={step >= 4} aria-current={step === 4 ? "step" : undefined}>
              <b>4</b>
              <span>Test</span>
            </li>
          </ol>
        )
      }

      <slot />
    </div>

    <script>
      // At-a-glance health + a dismissible banner, so a down back-end is visible
      // instead of leaving the merchant with blank or redirecting pages.
      // Readiness probe is `/healthz` (non-OK => degraded).
      (() => {
        const DISMISS_KEY = "mc-svc-banner-dismissed";
        const banner = document.getElementById("svc-banner");
        const dot = document.getElementById("svc-dot");

        const setDot = (state, label) => {
          if (!dot) return;
          dot.dataset.state = state;
          dot.title = label;
        };

        const revealBanner = () => {
          if (!banner) return;
          try {
            if (sessionStorage.getItem(DISMISS_KEY) === "1") return;
          } catch {
            /* private mode — just show it */
          }
          banner.removeAttribute("hidden");
        };

        banner?.querySelector("[data-dismiss]")?.addEventListener("click", () => {
          banner.setAttribute("hidden", "");
          try {
            sessionStorage.setItem(DISMISS_KEY, "1");
          } catch {
            /* ignore */
          }
        });

        (async () => {
          try {
            const res = await fetch("/healthz", {
              headers: { accept: "application/json" },
              cache: "no-store",
            });
            if (res.ok) {
              setDot("up", "Payments service: operational");
              return;
            }
            setDot("down", "Payments service: degraded");
            revealBanner();
          } catch {
            setDot("down", "Payments service: unreachable");
            revealBanner();
          }
        })();
      })();
    </script>
  </body>
</html>
